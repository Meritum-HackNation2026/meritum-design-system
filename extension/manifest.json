{
  "manifest_version": 3,
  "name": "Meritum",
  "short_name": "Meritum",
  "description": "Obywatelski radar dezinformacji. Sprawdź post i zobacz werdykt ze źródłami.",
  "version": "0.1.0",
  "minimum_chrome_version": "111",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Meritum",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "options_ui": { "page": "onboarding/options.html", "open_in_tab": true },
  "background": { "service_worker": "reference/background.js" },
  "permissions": ["storage", "activeTab"],
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*", "https://*.x.com/*",
        "https://twitter.com/*", "https://*.twitter.com/*",
        "https://*.facebook.com/*",
        "https://*.instagram.com/*",
        "https://*.reddit.com/*",
        "https://*.tiktok.com/*",
        "https://*.gburek.app/*",
        "http://localhost:52990/*"
      ],
      "js": ["reference/api.js", "reference/card.js", "reference/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["widget.css", "pl.json"],
      "matches": [
        "https://x.com/*", "https://*.x.com/*", "https://twitter.com/*", "https://*.twitter.com/*",
        "https://*.facebook.com/*", "https://*.instagram.com/*", "https://*.reddit.com/*", "https://*.tiktok.com/*",
        "https://*.gburek.app/*", "http://localhost:52990/*"
      ]
    }
  ]
}
